# MongoDB connection string (local default)
MONGODB_URI=mongodb://127.0.0.1:27017/Travel-crm

# API server port
PORT=5000

# Razorpay API keys (Dashboard → Account & Settings → API Keys)
# Use rzp_test_ keys while testing. The secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. "Create itinerary with AI" uses these when set.
# Leave both blank to build the day plan from the destination and activity library.
# GEMINI_API_KEY is used first. Restart the app after adding a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
